# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=qt6-base
pkgver=6.10.0
pkgrel=1
pkgdesc="A cross-platform application and UI framework"
url="https://qt.io/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
_sub="$pkgname-sqlite"
depends="at-spi2-core-libs
        brotli
        cairo
        cairo-gobject
        dbus
        double-conversion
        fontconfig
        freetype
        gdk-pixbuf
        glib
        gtk3
        harfbuzz
        icu-libs
        libb2
        libc++
        libcrypto3
        libintl
        libjpeg-turbo
        libpcre2-16
        libpng
        libssl3
        libxkbcommon
        md4c-libs
        pango
        tzdata
        wayland
        zlib-ng
        zstd-libs
        qnx-egl
        qnx-fs-notify
        qnx-gles
        qnx-io-sock
        qnx-libdrm
        qnx-libgbm
        qnx-libslog2
        qnx-screen
        "
depends_dev="$_sub
    clang
    dbus-dev
    double-conversion-dev
    fontconfig-dev
    freetype-dev
    glib-dev
    gobject-introspection-dev
    gtk3-dev
    harfbuzz-dev
    icu-dev
    libb2-dev
    libc++-dev
    libjpeg-turbo-dev
    libpng-dev
    libxkbcommon-dev
    libxml2-dev
    md4c-dev
    openssl-dev>3
    pcre2-dev
    sqlite-dev
    vulkan-headers
    wayland-dev
    zlib-dev
    qnx-fs-notify-dev
    qnx-io-sock-dev
    qnx-libdrm-dev
    qnx-libgbm-dev
    qnx-libslog2-dev
    qnx-screen-dev
    "
makedepends="$depends_dev
    cmake
    perl
    ninja
    "
subpackages="
    $pkgname-dbg
    $pkgname-private-dev:private_dev
    $pkgname-doc
    $pkgname-dev
    $_sub
    "
builddir="$srcdir/qtbase-everywhere-src-${pkgver/_/-}"
source="https://download.qt.io/official_releases/qt/${pkgver%.*}/${pkgver/_/-}/submodules/qtbase-everywhere-src-${pkgver/_/-}.tar.xz
    001-enable-file-base-clipboard.patch
    002-remove-qnx-specific-flags.patch
    "
options="!check"

build() {
    # It's qcc here, but compiled with clang on the selfhosted system
    if [[ $CARCH == "x86_64" ]]; then
        _triplet="qnx-x86-64-qcc"
    elif [[ $CARCH == "aarch64" ]]; then
        _triplet="qnx-aarch64le-qcc"
    else
        die "$CARCH not supported"
    fi
    
    _dir_opts="-DCMAKE_SKIP_RPATH=ON \
        -DINSTALL_BINDIR=lib/qt6/bin \
        -DINSTALL_PUBLICBINDIR=usr/bin \
        -DINSTALL_LIBEXECDIR=lib/qt6 \
        -DINSTALL_DOCDIR=share/doc/qt6 \
        -DINSTALL_ARCHDATADIR=lib/qt6 \
        -DINSTALL_DATADIR=share/qt6 \
        -DINSTALL_INCLUDEDIR=include/qt6 \
        -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
        -DINSTALL_EXAMPLESDIR=share/doc/qt6/examples"

    # Clang does not support fortify source on QNX
    _warn="-Wno-character-conversion"

    export CC=clang
    export CXX=clang++
    export CFLAGS="$_warn"
    export CXXFLAGS="$_warn"
    export LDFLAGS="-lsocket"
    export LD_LIBRARY_PATH="$builddir/build/lib:$LD_LIBRARY_PATH"

    cmake -B build -G Ninja -Wno-dev \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo  \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
        -DCMAKE_MESSAGE_LOG_LEVEL=VERBOSE \
        -DQT_QMAKE_TARGET_MKSPEC=$_triplet \
        -DQT_FIND_ALL_PACKAGES_ALWAYS=ON \
        -DFEATURE_clipboard=ON \
        -DFEATURE_journald=OFF \
        -DFEATURE_libproxy=OFF \
        -DFEATURE_openssl_linked=ON \
        -DFEATURE_pkg_config=ON \
        -DFEATURE_reduce_relocations=OFF \
        -DFEATURE_slog2=ON \
        -DFEATURE_eglfs=ON \
        -DFEATURE_system_sqlite=ON \
        -DFEATURE_vulkan=ON \
        -DFEATURE_opengles2=ON \
        -DFEATURE_xkbcommon=ON \
        $_dir_opts

    cmake --build build --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    cd "$pkgdir"
    mkdir -p usr/bin
    while read -r _line; do
        ln -s $_line
    done < "$builddir"/build/user_facing_tool_links.txt
}

dev() {
    default_dev

    amove usr/lib/qt6/bin
    amove usr/lib/qt6/sbom
}

private_dev() {
    depends="$pkgname-dev=$pkgver-r$pkgrel"
    local file; find "$pkgdir"/usr/include -type d -name private | while read -r file; do
        amove "${file#"$pkgdir"}"
    done
    amove usr/lib/cmake/*Private
    amove usr/lib/qt6/modules/*Private.json
}

sqlite() {
    pkgdesc="SQLite driver for Qt6's SQL classes"
    depends="$pkgname=$pkgver-r$pkgrel sqlite-libs"
    amove usr/lib/qt6/plugins/sqldrivers/libqsqlite*
}

